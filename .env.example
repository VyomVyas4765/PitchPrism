NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/pitchprism
# API and seed read the ignored root .env, not this template. Atlas URLs belong there.
MONGODB_TIMEOUT_MS=10000
# Optional process DNS override for broken network resolvers; blank uses system DNS.
# This cannot fix a nonexistent Atlas hostname or unblock database ports.
MONGODB_DNS_SERVERS=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Used only by pnpm seed. Choose at least 12 characters; no default password exists.
SEED_PASSWORD=
# Bootstrap HQ admin created by pnpm seed; everyone else joins by invitation from the dashboard.
SEED_ADMIN_EMAIL=hq_admin@pitchprism.test
# Development only: also seed one synthetic account per staff role (true/false).
SEED_DEMO_STAFF=false
# Enables real entrepreneur phone-token verification. Leave blank until configured.
FIREBASE_PROJECT_ID=
# Set GOOGLE_APPLICATION_CREDENTIALS in your shell to a private service-account file.
# Seals entrepreneur personal fields at rest: 64 hex characters (pnpm setup:env generates one).
# Blank disables profile storage. Changing or losing it makes stored profiles unreadable.
PII_ENCRYPTION_KEY=

# Local AI only. No hosted AI APIs, paid fallback, or automatic model downloads.
AI_RUNTIME=local
AI_HOSTED_APIS_ENABLED=false
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
# Choose an installed, locally reviewed model after dataset/language testing.
LOCAL_LLM_MODEL=
AI_MAX_MODEL_BYTES=3221225472
AI_REQUEST_TIMEOUT_SECONDS=60
