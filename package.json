{
  "name": "pitchprism",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": { "node": ">=22.13.0 <23" },
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "duties:check": "node scripts/check-duties.mjs",
    "db:check": "pnpm --filter @pitchprism/backend db:check",
    "db:local": "node backend/scripts/local-mongo.mjs",
    "dev:local": "node backend/scripts/dev-local.mjs",
    "worker": "pnpm --filter @pitchprism/backend worker",
    "ios": "node scripts/run-ios.mjs",
    "matrix:generate": "node scripts/generate-matrix.mjs",
    "dev": "pnpm --filter @pitchprism/contracts build && pnpm --parallel --filter @pitchprism/backend --filter @pitchprism/frontend dev",
    "build": "pnpm --filter @pitchprism/contracts build && pnpm --filter @pitchprism/backend build && pnpm --filter @pitchprism/frontend build",
    "typecheck": "pnpm --filter @pitchprism/contracts build && pnpm --filter @pitchprism/backend typecheck && pnpm --filter @pitchprism/frontend typecheck",
    "test": "pnpm --filter @pitchprism/contracts build && pnpm --filter @pitchprism/backend test",
    "contracts:generate": "pnpm --filter @pitchprism/contracts generate",
    "seed": "pnpm --filter @pitchprism/contracts build && pnpm --filter @pitchprism/backend seed"
  }
}
