{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PasswordReset",
  "description": "One-time staff password-reset link issued by an administrator in scope (no email provider, like invitations, D-27). Only a SHA-256 hash of the token is stored. Valid 24 hours, single use; issuing a new link withdraws earlier unused ones.",
  "x-collection": "passwordResets",
  "type": "object",
  "additionalProperties": false,
  "required": ["tokenHash", "userId", "orgId", "issuedByUserId", "expiresAt"],
  "properties": {
    "tokenHash": { "type": "string", "pattern": "^[a-f\\d]{64}$" },
    "userId": { "$ref": "common.json#/definitions/ObjectId" },
    "orgId": { "$ref": "common.json#/definitions/ObjectId" },
    "issuedByUserId": { "$ref": "common.json#/definitions/ObjectId" },
    "expiresAt": { "$ref": "common.json#/definitions/DateTime" },
    "usedAt": { "$ref": "common.json#/definitions/DateTime" },
    "revokedAt": { "$ref": "common.json#/definitions/DateTime" },
    "createdAt": { "$ref": "common.json#/definitions/DateTime" },
    "updatedAt": { "$ref": "common.json#/definitions/DateTime" }
  }
}
