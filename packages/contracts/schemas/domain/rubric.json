{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rubric",
  "description": "One immutable rubric version (PRD section 13, W-02). Saving a change creates a new version; evaluations record the version they used.",
  "x-collection": "rubrics",
  "type": "object",
  "additionalProperties": false,
  "required": ["rubricKey", "version", "name", "domains", "bands", "status"],
  "properties": {
    "rubricKey": { "type": "string", "pattern": "^[a-z0-9_-]{2,60}$" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "title": "RubricDomain",
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "weight", "lowDescriptor", "highDescriptor"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z_]{2,40}$" },
          "label": { "type": "string", "maxLength": 80 },
          "weight": { "type": "number", "minimum": 0, "maximum": 100, "description": "Percent; potential domains sum to 100." },
          "lowDescriptor": { "type": "string", "maxLength": 400, "description": "What earns a 1." },
          "highDescriptor": { "type": "string", "maxLength": 400, "description": "What earns a 5." },
          "evidenceFields": { "type": "array", "items": { "$ref": "common.json#/definitions/CanonicalField" } }
        }
      }
    },
    "completenessWeights": { "type": "object", "description": "Weight per canonical field for completeness.", "additionalProperties": { "type": "number", "minimum": 0 } },
    "bands": {
      "title": "RubricBands",
      "type": "object",
      "additionalProperties": false,
      "required": ["strong", "promising", "minCoverage"],
      "properties": {
        "strong": { "type": "number", "minimum": 0, "maximum": 100 },
        "promising": { "type": "number", "minimum": 0, "maximum": 100 },
        "minCoverage": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "pathwayRules": { "type": "object", "description": "Thresholds for the pathway calculator (Dev 2). Free-form until Dev 2 freezes the calculator inputs." },
    "status": { "type": "string", "enum": ["draft", "published", "archived"] },
    "createdByUserId": { "$ref": "common.json#/definitions/ObjectId" },
    "createdAt": { "$ref": "common.json#/definitions/DateTime" },
    "updatedAt": { "$ref": "common.json#/definitions/DateTime" }
  }
}
