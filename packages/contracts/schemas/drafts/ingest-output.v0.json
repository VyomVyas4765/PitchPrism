{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pitchprism.local/contracts/drafts/ingest-output.v0.json",
  "title": "IngestOutput",
  "description": "DRAFT v0 (Dev 1 proposal; Dev 3 integrates under D-03, Dev 2 reviews). The hand-off after the extract stage: Dev 2's stages read only segments, qa and fields. Not wired into contract generation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["submissionId", "contractVersion", "segments", "qa", "fields", "summary", "problemAddressed"],
  "properties": {
    "submissionId": { "type": "string" },
    "contractVersion": { "const": "ingest-output.v0" },
    "segments": { "type": "array", "items": { "$ref": "#/$defs/Segment" } },
    "qa": { "type": "array", "items": { "$ref": "#/$defs/QA" } },
    "fields": {
      "type": "object",
      "description": "Canonical fields with citations (A-12). A field with no citation is absent, never invented.",
      "propertyNames": { "$ref": "#/$defs/CanonicalField" },
      "additionalProperties": { "$ref": "#/$defs/CitedValue" }
    },
    "summary": { "anyOf": [{ "$ref": "#/$defs/CitedValue" }, { "type": "null" }] },
    "problemAddressed": { "anyOf": [{ "$ref": "#/$defs/CitedValue" }, { "type": "null" }] }
  },
  "$defs": {
    "Language": { "enum": ["hi", "mr", "te", "or", "bn", "en", "und"] },
    "SegId": { "type": "string", "pattern": "^s_\\d{4,}$" },
    "CanonicalField": {
      "description": "Appendix B.1: ten core fields, then extended fields from the Business Plan and platform forms.",
      "enum": ["location", "offering", "customers", "market_research", "raw_materials", "suppliers", "funding", "competition", "unit_price", "monthly_revenue",
        "business_name", "problem_addressed", "differentiation", "pricing_strategy", "support_network", "infrastructure", "transport", "staff",
        "fixed_overheads", "chosen_area", "customer_reach", "promotion_plan", "promotion_budget", "yearly_goals", "investment_required",
        "self_investment", "expected_loan", "market_type", "existing_business", "customer_gender", "customer_age_range", "customer_segment"]
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "documentId"],
      "properties": {
        "type": { "enum": ["audio", "pdf", "image", "text"] },
        "documentId": { "type": "string" },
        "chunkId": { "type": "string", "description": "Audio chunk from A-03 (c_0001)." },
        "start": { "type": "number", "minimum": 0, "description": "Seconds from the start of the original recording." },
        "end": { "type": "number", "minimum": 0 },
        "page": { "type": "integer", "minimum": 1 },
        "bbox": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4, "description": "PDF points [x0, y0, x1, y1] on the original page." },
        "charStart": { "type": "integer", "minimum": 0, "description": "Typed text: offsets into the original answer, in Unicode code points." },
        "charEnd": { "type": "integer", "minimum": 0 }
      }
    },
    "Segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segId", "source", "text", "lang", "textEn", "struck", "supersededBy", "confidence"],
      "properties": {
        "segId": { "$ref": "#/$defs/SegId" },
        "source": { "$ref": "#/$defs/Source" },
        "text": { "type": "string", "description": "Original-language text with personal details replaced by tokens (A-10). The only text a model may receive." },
        "lang": { "$ref": "#/$defs/Language" },
        "langs": { "type": "array", "items": { "$ref": "#/$defs/Language" }, "description": "All languages present when code-mixed; translated whole (A-11)." },
        "textEn": { "type": ["string", "null"], "description": "English translation of the redacted text; null until translation runs or when it failed (see confidence)." },
        "translit": { "type": ["string", "null"] },
        "struck": { "type": "boolean", "description": "Struck-through or scribbled-out value (A-08); kept as history, never used as the answer." },
        "supersededBy": { "anyOf": [{ "$ref": "#/$defs/SegId" }, { "type": "null" }] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "Reading confidence (STT/OCR). Null for typed text." },
        "unreadable": { "type": "boolean", "description": "Below the read threshold: shown to assessors as an image crop or audio clip, not guessed." }
      }
    },
    "QA": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qId", "question", "questionLang", "answerSegIds", "canonicalField", "state", "overwrites"],
      "properties": {
        "qId": { "type": "string" },
        "question": { "type": ["string", "null"], "description": "Null when the template did not ask it (state not_asked)." },
        "questionLang": { "$ref": "#/$defs/Language" },
        "answerSegIds": { "type": "array", "items": { "$ref": "#/$defs/SegId" } },
        "canonicalField": { "anyOf": [{ "$ref": "#/$defs/CanonicalField" }, { "type": "null" }], "description": "Null for additional questions kept as extra Q&A (A-09)." },
        "mappingConfidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "state": { "enum": ["answered", "missing", "not_asked", "irrelevant"], "description": "A-09 sets answered/missing/not_asked; irrelevant is set by quality checks (A-13, Dev 2)." },
        "blankMarker": { "type": ["string", "null"], "description": "Literal marker such as [Left Blank] when state is missing." },
        "overwrites": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["fromSegId", "toSegId"],
            "properties": { "fromSegId": { "$ref": "#/$defs/SegId" }, "toSegId": { "$ref": "#/$defs/SegId" } }
          }
        }
      }
    },
    "CitedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "segIds"],
      "properties": {
        "value": { "type": "string", "minLength": 1, "description": "English, redacted." },
        "segIds": { "type": "array", "items": { "$ref": "#/$defs/SegId" }, "minItems": 1 },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    }
  }
}
